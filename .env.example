# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- required ---------------------------------------------------------------------------------
# OpenRouter powers the agent, the in-tool calls (SQL, reports) and the two judges.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini is the fallback provider and the embedding model for the golden bucket.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GCP project billed for BigQuery bytes (public dataset, 1 TB/month free tier).
# Auth is Application Default Credentials: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=

# --- optional: models -------------------------------------------------------------------------
# One model runs everything; the fallback is used only when OpenRouter is unreachable.
# MODEL=google/gemini-2.5-flash
# FALLBACK_MODEL=gemini-3.5-flash

# --- optional: quality evaluation --------------------------------------------------------------
# Two DIFFERENT families on purpose: same-family judges share failure modes and agree
# confidently on the same wrong answer, which reads as corroboration but is not.
# JUDGE_A=google/gemini-2.5-flash
# JUDGE_B=anthropic/claude-haiku-4.5
# JUDGE_IDLE_MINUTES=20                           # how long a session must be quiet to be judged

# --- optional: determinism ----------------------------------------------------------------------
# Sampling temperature for every model call. Zero by default so the same question yields the same SQL
# and the same judge verdict; raise it only if you deliberately want variation.
# TEMPERATURE=0.0

# --- optional: gcloud ---------------------------------------------------------------------------
# CLOUDSDK_CONFIG=
